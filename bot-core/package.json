{
  "name": "whatsapp-bot-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp bot core (Baileys transport + typed middleware router).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
