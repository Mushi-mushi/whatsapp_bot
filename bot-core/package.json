    "ipaddr.js": "^2.5.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "sentiment": "^5.0.2",
    "sharp": "^0.35.4",
    "undici": "^7.29.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
