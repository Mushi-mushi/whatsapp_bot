# .dockerignore

# Ignore the user_data directory during the build process.
# This contains temporary session data and should not be part of the image.
#user_data/

# Ignore Python's cache files
__pycache__/

# Ignore VSCode settings if they exist
.vscode/


# .dockerignore

# Ignore the session lock and state files that cause Chrome to crash on startup.
user_data/session/SingletonLock
user_data/session/SingletonCookie
user_data/session/SingletonSocket
user_data/session/Default/SingletonLock
user_data/session/Default/SingletonCookie
user_data/session/Default/SingletonSocket
user_data/session/DevToolsActivePort

# Ignore temporary cache folders to keep the image small
user_data/session/GrShaderCache/
user_data/session/ShaderCache/
user_data/session/GraphiteDawnCache/

# Also ignore these for good measure
__pycache__/
.vscode/